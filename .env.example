# Required
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands to one server for instant updates
DISCORD_GUILD_ID=

# GitHub login and project channels (/github, /project, /git): see docs/github-setup.md
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
PUBLIC_URL=http://localhost:3000
# 32 random bytes, base64: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
WEB_PORT=3000
DATABASE_PATH=data/fembot.db

# Optional: /code-review tuning
REVIEW_MODEL=LiquidAI/d1-2B
REVIEW_THRESHOLD=0.8
